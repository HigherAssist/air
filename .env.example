# ==========================================================================
# AIR Application - Environment Configuration
# ==========================================================================
# Copy this file to .env and fill in the values for your environment.
# Backend secrets (marked with [SECRET]) should be set via:
#   npx ampx sandbox secret set KEY_NAME          (local dev)
#   npx ampx secret set KEY_NAME --branch BRANCH  (deployed environments)
# ==========================================================================

# --- Environment Identifier ---
# Which environment this instance runs in: dev | stage | prod
VITE_APP_ENV=dev

# --- AWS Region ---
# The AWS region where your Amplify backend is deployed
VITE_AWS_REGION=us-east-1

# --- Cloudflare Turnstile ---
# Site key (public, used in frontend widget)
VITE_TURNSTILE_SITE_KEY=
# [SECRET] Secret key (used in Lambda for server-side verification)
# Set via: npx ampx sandbox secret set TURNSTILE_SECRET_KEY

# --- Stripe (Frontend) ---
# Publishable key (public, safe to expose in frontend)
# Use pk_test_xxx for dev/stage, pk_live_xxx for prod
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Stripe (Backend - Lambda secrets) ---
# [SECRET] Secret key: sk_test_xxx (dev/stage) or sk_live_xxx (prod)
# Set via: npx ampx sandbox secret set STRIPE_SECRET_KEY
#
# [SECRET] Webhook signing secret: whsec_xxx
# Set via: npx ampx sandbox secret set STRIPE_WEBHOOK_SECRET
#
# [SECRET] Stripe Price IDs for each subscription tier
# Create Products and Prices in Stripe Dashboard, then set:
# Set via: npx ampx sandbox secret set STRIPE_PRICE_STARTER
# Set via: npx ampx sandbox secret set STRIPE_PRICE_PROFESSIONAL
# Set via: npx ampx sandbox secret set STRIPE_PRICE_ENTERPRISE

# --- Registration Codes ---
# [SECRET] Comma-separated codes required for new user signup
# Set via: npx ampx sandbox secret set REGISTRATION_CODES
# Example value: Beta_Customer_R1,Beta_Customer_R2,Beta_Customer_R3

# --- SES Email ---
# [SECRET] Verified SES sender email for notifications
# Set via: npx ampx sandbox secret set SES_EMAIL

# --- Application URLs ---
# Base URL of the application (used for email links, redirects)
VITE_APP_URL=http://localhost:5173
# Stripe Checkout redirect URLs
VITE_CHECKOUT_SUCCESS_URL=http://localhost:5173/success
VITE_CHECKOUT_CANCEL_URL=http://localhost:5173/subscribe

# --- Branch identifier ---
# Used for environment-specific logic in frontend
VITE_BRANCH=dev

# --- Services iframe URL (if applicable) ---
# Base URL for the services iframe (Gradio or other service endpoint)
# VITE_SERVICES_URL=https://dev.example.com:7860
