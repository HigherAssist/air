# ============================================================
# AIR Candidate Sourcing Chatbot — Environment Configuration
# Copy this file to .env and fill in all required values.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# Format: postgresql+asyncpg://user:password@host:5432/dbname
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sourcing:changeme@localhost:5432/sourcing

# Synchronous URL (used by scripts and Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://sourcing:changeme@localhost:5432/sourcing

# ------------------------------------------------------------
# Groq API (LLM backend — Llama 3.3 70B, free tier)
# Get your key at: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# Groq model ID — update when newer Llama models become available
GROQ_MODEL=llama-3.3-70b-versatile

# LLM temperature: 0.0-0.2 recommended for grounded, factual answers
GROQ_TEMPERATURE=0.1

# Max tokens for LLM responses (matching: 300, chat: 1024)
GROQ_MAX_TOKENS=1024

# How long (seconds) to wait for a Groq response before giving up
GROQ_TIMEOUT_SECONDS=15

# ------------------------------------------------------------
# Loxo ATS API Credentials
# ------------------------------------------------------------
LOXO_BASE_URL=https://app.loxo.co/api
LOXO_AGENCY_SLUG=artizen-staffing
LOXO_USERNAME=artizen-staffing_api2
LOXO_PASSWORD=ukc5dfv8APY0urkrcp

# Seconds to sleep between Loxo API requests during bulk sync
# Increase if you hit rate limits during initial load
LOXO_REQUEST_SLEEP=0.25

# Max retries per Loxo API request on failure
LOXO_MAX_RETRIES=3

# ------------------------------------------------------------
# AWS / S3 (for resume PDF storage)
# ------------------------------------------------------------
S3_BUCKET=artizen-sourcing-resumes-dev
AWS_REGION=us-east-2

# ------------------------------------------------------------
# Embedding Model (sentence-transformers, runs locally in container)
# Change to a larger model for higher quality at cost of memory/speed
# Options: all-MiniLM-L6-v2 (384-dim, fast), all-mpnet-base-v2 (768-dim, better)
# ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ------------------------------------------------------------
# Data Sync Schedule
# How many hours between Loxo data syncs (default: 24 = once daily)
# ------------------------------------------------------------
SYNC_INTERVAL_HOURS=24

# Candidate global status IDs to include in sync (comma-separated Loxo IDs)
# Option B: Contacted(30199), Applied(30200), Replied(30201), In Progress(30202),
#           Nurture(30203), Unresponsive(30204), Hired(30207)
CANDIDATE_STATUS_IDS=30199,30200,30201,30202,30203,30204,30207

# Loxo job status ID for active jobs
LOXO_ACTIVE_JOB_STATUS_ID=6875

# ------------------------------------------------------------
# Matching Service
# ------------------------------------------------------------
# Number of candidates to retrieve via vector similarity before LLM scoring
MATCH_TOP_K_VECTOR=30

# Number of top-vector candidates to actually score with LLM
MATCH_TOP_K_LLM=20

# Minimum match score (0-100) to store in DB and return to recruiter
MATCH_MIN_SCORE=30

# Seconds to sleep between Groq calls during batch pre-computation
# At 30 req/min free tier limit, 2.0s keeps well under the limit
MATCH_LLM_SLEEP=2.0

# ------------------------------------------------------------
# Chat / Session Management
# ------------------------------------------------------------
# Max number of chat sessions to store per user (oldest are purged)
MAX_CHAT_SESSIONS=5

# Number of previous messages to include as context in each LLM call
MAX_HISTORY_MESSAGES=20

# Override timeout for chat responses (should be <= GROQ_TIMEOUT_SECONDS)
CHAT_TIMEOUT_SECONDS=15

# ------------------------------------------------------------
# API Security
# Simple HMAC secret used to validate tokens passed from the AIR iframe.
# Set this to a long random string. Must match VITE_SOURCING_TOKEN_SECRET in AIR.
# ------------------------------------------------------------
API_TOKEN_SECRET=change-this-to-a-long-random-secret-in-production

# ------------------------------------------------------------
# CORS — origins allowed to call the backend
# Space-separated list of allowed origins for the chatbot frontend
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000 http://localhost:5173 https://dev.d3carnh06cjb9r.amplifyapp.com

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/sourcing.log
